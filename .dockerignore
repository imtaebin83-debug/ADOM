# Ignore files and directories that are not needed in the Docker image
.git/
.github/
.cache/
**/__pycache__/
*.pyc

# Ignore data, outputs, and model checkpoints/exports
datasets/
data/
outputs/
models/checkpoints/
models/exports/
wandb/

# Ignore large model files and logs
*.pth
*.pt
*.ckpt
*.onnx
*.engine
*.plan
*.trt
*.log

# Sensitive files and environment configurations
.env
.env.*
.venv/
venv/
