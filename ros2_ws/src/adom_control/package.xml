<?xml version="1.0"?>
<package format="3">
  <name>adom_control</name>
  <version>0.1.0</version>
  <description>Twist-to-Ackermann and PCA9685 PWM control for ADOM.</description>
  <maintainer email="adom@example.com">ADOM Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>python3-smbus</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
